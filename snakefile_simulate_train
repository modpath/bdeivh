localrules: all

folder = os.path.abspath(config.get("folder", '.'))
num = int(config.get("num", 1))
REPETITIONS = list(range(num))
os.makedirs('logs', exist_ok=True)

sim_folder = os.path.join(folder, config.get("sf", 'train'))
MODELS = ['MTBD']
SIZES=['100_300']

TREES_PER_FILE = 1

snakemake_settings = "  --rerun-triggers mtime --keep-going --cores 1 --jobs 500 --rerun-incomplete --cluster  \"sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common,dedicated --qos=fast  -J {params.name}\"  --use-singularity --singularity-prefix \"$HOME/.singularity\" --singularity-args \"-B /pasteur\" " \
    if "pasteur" in folder else " --rerun-triggers mtime --keep-going --cores 12 --use-singularity --singularity-prefix ~/.singularity --singularity-args \"--home ~\""


rule all:
    input:
        expand(os.path.join(sim_folder, '{size}', '{model}', '{k}', 'trees.{i}.nwk'), \
            k=REPETITIONS, i=REPETITIONS, model=MODELS, size=SIZES)
    shell:
        """
        snakemake --snakefile Snakefile_encode --config num={num} {snakemake_settings} --unlock
        snakemake --snakefile Snakefile_encode --config num={num} {snakemake_settings}
        """

rule simulate_trees:
    output:
        log=os.path.join(sim_folder, '{mint}_{maxt}', '{model}', '{k}','trees.{i}.log'),
        nwk=os.path.join(sim_folder, '{mint}_{maxt}', '{model,[MTBD]+}','{k}','trees.{i}.nwk'),
    params:
        mem=2000,
        name='sim.{model}',
        qos='fast',
    threads: 1
    singularity: "docker://evolbioinfo/bdext:v0.1.66"
    shell:
        """         
        python3 bdeissct-main/simulations_bdeissct/py/generate_tree_sets.py \
        --log {output.log} \
        --nwk {output.nwk} \
        --min_tips {wildcards.mint} \
        --max_tips {wildcards.maxt} \
        --n {TREES_PER_FILE} \
        --min_RVH 0.5 \
        --max_RVH 5.0 \
        --min_RHV 0.5 \
        --max_RHV 5.0 \
        --min_UV 0.08 \
        --max_UV 0.17 \
        --min_UH 0.10 \
        --max_UH 1.0 \
        --min_PSIV 0.05 \
        --max_PSIV 0.10 \
        --min_PSIH 0.20 \
        --max_PSIH 0.50 \
        --min_RHO 0.001 \
        --max_RHO 0.10 \
        --model {wildcards.model}
        """
