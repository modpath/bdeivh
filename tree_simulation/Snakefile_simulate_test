localrules: all

os.makedirs('logs',exist_ok=True)
folder = os.path.abspath(config.get("folder", '.'))

# If we are on the cluster create log folder
if "pasteur" in folder:
    snakemake_settings = " --rerun-triggers mtime --keep-going --cores 1 --jobs 500 --rerun-incomplete --cluster \"sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common --qos=normal  -J {params.name}\"  --use-singularity --singularity-prefix \"$HOME/.singularity\" --singularity-args \"-B /pasteur\" "
else:
    snakemake_settings = " --rerun-triggers mtime --keep-going --cores 12 --use-singularity --singularity-prefix ~/.singularity --singularity-args \"--home ~\""


N = int(config.get("num", 1000))
mint = int(config.get("mint", 250))
maxt = int(config.get("maxt", 350))
sf = config.get("sf", 'test')
sim_folder = os.path.join(folder, sf)

TREES_PER_FILE = 1

rule all:
    input:
        expand(os.path.join(sim_folder, f'{mint}_{maxt}', 'tree.{i}.nwk'), i=range(N)),
    shell:
        """
        snakemake --snakefile Snakefile_merge_test --config mint={mint} maxt={maxt} num={N} sf={sf} {snakemake_settings} --unlock
        snakemake --snakefile Snakefile_merge_test --config mint={mint} maxt={maxt} num={N} sf={sf}  {snakemake_settings}
        """


rule simulate_trees:
    output:
        log=os.path.join(sim_folder, '{mint}_{maxt}', 'tree.{i}.log'),
        nwk=os.path.join(sim_folder, '{mint}_{maxt}', 'tree.{i}.nwk'),
    params:
        mem=2000,
        name='sim_test',
        qos='fast',
    threads: 1
    singularity: "docker://evolbioinfo/treesimulator:v0.2.30"
    shell:
        """
        echo "python3 Generate_tree_sets.py --log {output.log} --nwk {output.nwk} --min_tips {wildcards.mint} --max_tips {wildcards.maxt} --n {TREES_PER_FILE} --min_RHH 1.0 --max_RHH 5.0 --min_DV 10.0 --max_DV 20.0 --min_DH 3.0 --max_DH 15.0 --min_RHO 0.01 --max_RHO 0.50"
                 
        python3 Generate_tree_sets.py \
        --log {output.log} \
        --nwk {output.nwk} \
        --min_tips {wildcards.mint} \
        --max_tips {wildcards.maxt} \
        --n {TREES_PER_FILE} \
        --min_RHH 1.0 \
        --max_RHH 5.0 \
        --min_DV 10.0\
        --max_DV 20.0\
        --min_DH 3.0\
        --max_DH 15.0\
        --min_RHO 0.01 \
        --max_RHO 0.50
        """
