import os

localrules: all

os.makedirs('logs', exist_ok=True)
folder = os.path.abspath(config.get("folder", '.'))

NUM_TREES = int(config.get("trees", 100))
NUM_SUBFOLDERS = int(config.get("folders", 100))
sf = config.get("sf", 'train')
mint = int(config.get("mint", 150))
maxt = int(config.get("maxt", 250))

train_folder = os.path.join(folder, sf, f'{mint}_{maxt}')


rule all:
    input:
        os.path.join(train_folder, 'trees.nwk'),
        os.path.join(train_folder, 'trees.log'),
        os.path.join(train_folder, 'trees.tsv.xz')

rule merge:
    input:
        nwks = expand(os.path.join(train_folder, 'set_{j}', 'tree.{k}.nwk'), j=range(NUM_SUBFOLDERS), k=range(NUM_TREES)),
        logs = expand(os.path.join(train_folder, 'set_{j}', 'tree.{k}.log'), j=range(NUM_SUBFOLDERS), k=range(NUM_TREES))
    output:
        nwks = os.path.join(train_folder, 'trees.nwk'),
        logs = os.path.join(train_folder, 'trees.log')
    params:
        name = "merge_all_train",
        mem=2000,
        qos='fast'
    threads: 1
    shell:
        """
        for f in {input.nwks}; do
            cat "$f"
            echo
        done > {output.nwks}

        first=1

        for f in {input.logs}; do
            if [ $first -eq 1 ]; then
                # print header + rest of the file
                cat "$f"
                first=0
            else
                # skip header (NR>1)
                tail -n +2 "$f"
            fi
        done > {output.logs}
        """


rule encode:
    input:
        nwks = os.path.join(train_folder, 'trees.nwk'),
    output:
        tsv = os.path.join(train_folder, 'trees.tsv.xz')
    params:
        name = "encode_train",
        mem=2000,
        qos='fast'
    threads: 1
    singularity: "docker://evolbioinfo/bdeivh:v0.1.5"
    shell:
        """
        bdeivh_encode -t {input.nwks} -o {output.tsv}
        """