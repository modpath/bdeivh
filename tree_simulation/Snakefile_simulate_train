import os

# To run locally:
# snakemake --snakefile Snakefile_simulate_train --keep-going --cores 10 --use-singularity --singularity-prefix ~/.singularity --singularity-args "--home ~"
#
# To run on maestro:
# source ~/.bashrc && conda activate snakemake && module load apptainer && cd /pasteur/helix/projects/mPath/<path to this project>
# snakemake --snakefile Snakefile_simulate_train --keep-going --cores 1 --use-singularity --singularity-prefix $HOME/.singularity --singularity-args "-B /pasteur" --cluster "sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} --qos=normal -J {params.name}" --jobs 500

localrules: all

folder = os.path.abspath(config.get("folder", '.'))

# If we are on the cluster create log folder
if "pasteur" in folder:
    os.makedirs('logs', exist_ok=True)
    snakemake_settings = "  --rerun-triggers mtime --keep-going --cores 1 --jobs 500 --rerun-incomplete --cluster  \"sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common --qos=normal  -J {params.name}\"  --use-singularity --singularity-prefix \"$HOME/.singularity\" --singularity-args \"-B /pasteur\" "
else:
    snakemake_settings = " --rerun-triggers mtime --keep-going --cores 12 --use-singularity --singularity-prefix ~/.singularity --singularity-args \"--home ~\""


NUM_TREES = int(config.get("trees", 100))
NUM_SUBFOLDERS = int(config.get("folders", 100))
TREES_PER_FILE = int(config.get("treesperfile", 10))
mint = int(config.get("mint", 250))
maxt = int(config.get("maxt", 350))
sf = config.get("sf", 'train')

sim_folder = os.path.join(folder, sf)

rule all:
    input:
        expand(os.path.join(sim_folder, f'{mint}_{maxt}', 'set_{j}', 'tree.{i}.nwk'), i=range(NUM_TREES), j=range(NUM_SUBFOLDERS))
    shell:
        """
        snakemake --snakefile Snakefile_merge_train --config mint={mint} maxt={maxt} trees={NUM_TREES} folders={NUM_SUBFOLDERS} sf={sf} {snakemake_settings} --unlock
        snakemake --snakefile Snakefile_merge_train --config mint={mint} maxt={maxt} trees={NUM_TREES} folders={NUM_SUBFOLDERS} sf={sf}  {snakemake_settings}
        """

rule simulate_trees:
    output:
        log=os.path.join(sim_folder, '{mint}_{maxt}', 'set_{j}', 'tree.{i}.log'),
        nwk=os.path.join(sim_folder, '{mint}_{maxt}', 'set_{j}', 'tree.{i}.nwk'),
    params:
        mem=2000,
        name='sim_train',
        qos='fast',
    threads: 1
    singularity: "docker://evolbioinfo/treesimulator:v0.2.30"
    shell:
        """
        python3 Generate_tree_sets.py \
        --log {output.log} \
        --nwk {output.nwk} \
        --min_tips {wildcards.mint} \
        --max_tips {wildcards.maxt} \
        --n {TREES_PER_FILE} \
        --min_RHH 1.0 \
        --max_RHH 5.0 \
        --min_DV 10.0\
        --max_DV 20.0\
        --min_DH 3.0\
        --max_DH 15.0\
        --min_RHO 0.01 \
        --max_RHO 0.50
        """
