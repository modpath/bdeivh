import os


# To run locally:
# snakemake --snakefile Snakefile_transform_OROV_train --keep-going --cores 1 --rerun-triggers mtime
# snakemake --snakefile Snakefile_transform_OROV_train --keep-going --cores 1 --use-singularity --singularity-prefix ~/.singularity --singularity-args "--home ~"

# To run on maestro:
# module load snakemake/7.32.3 && module load apptainer && cd/pasteur/helix/projects/mPath/<path to this project>
# snakemake --snakefile Snakefile_transform_OROV_train --keep-going --cores 1 --rerun-triggers mtime --use-singularity --singularity-prefix $HOME/.singularity --singularity-args "-B /pasteur" --cluster "sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common --qos={params.qos}  -J {params.name}" --jobs 1000 --config sf=train0 model=BDEISSCT


localrules: all

folder = os.path.abspath(config.get("folder",'.'))
num = int(config.get("num",100))
REPETITIONS = list(range(num))
os.makedirs('logs',exist_ok=True)

mint = int(config.get("mint",100))
maxt = int(config.get("maxt",300))

sf = config.get("sf",'train')

snakemake_settings = "  --rerun-triggers mtime --keep-going --cores 1 --jobs 500 --rerun-incomplete --cluster  \"sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common,dedicated --qos=fast  -J {params.name}\"  --use-singularity --singularity-prefix \"$HOME/.singularity\" --singularity-args \"-B /pasteur\" " \
    if "pasteur" in folder else " --rerun-triggers mtime --keep-going --cores 12 --use-singularity --singularity-prefix ~/.singularity --singularity-args \"--home ~\""

rule all:
    input:
        expand(os.path.join(folder,f'OROV_{sf}',f'{mint}_{maxt}','trees.{i}.nwk'),i=REPETITIONS),


rule tt2OROV:
    '''
    Transforms a transmission tree into a LSD2-dated OROV phylogeny.
    '''
    input:
        nwk=os.path.join(folder,'{train}',f'{mint}_{maxt}','trees.{i}.nwk'),
        log=os.path.join(folder,'{train}',f'{mint}_{maxt}','trees.{i}.log')
    output:
        nwk=os.path.join(folder,'OROV_{train}',f'{mint}_{maxt}','trees.{i}.nwk'),
        log=os.path.join(folder,'OROV_{train}',f'{mint}_{maxt}','trees.{i}.log')
    params:
        mem=1000,
        name='tt2ott',
        qos='normal',
    threads: 1
    shell:
        """
        mkdir -p {input.nwk}.phylogenies
        module load snakemake/7.32.3 && module load apptainer && cd {input.nwk}.phylogenies

        snakemake --snakefile {folder}/Snakefile_transform_OROV --config in_nwk={input.nwk} out_nwk={output.nwk} folder={folder} {snakemake_settings} --unlock
        snakemake --snakefile {folder}/Snakefile_transform_OROV --config in_nwk={input.nwk} out_nwk={output.nwk} folder={folder} {snakemake_settings}

        cp {input.log} {output.log}
        rm -rf {input.nwk}.phylogenies
        """
