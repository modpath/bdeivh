import os

# Compatible with Snakemake 7.32.x and the original --cluster submission command.
# Each Slurm job runs the complete inner workflow locally with one CPU.
localrules: all

folder = os.path.abspath(config.get("folder", "."))
num = int(config.get("num", 100))
set_num = int(config.get("set_num", 100))
mint = int(config.get("mint", 250))
maxt = int(config.get("maxt", 350))
sf = config.get("sf", "train")
TREES_PER_FILE = int(config.get("trees_per_file", 10))
MEM_MB = int(config.get("mem_mb", 6000))
LATENCY_WAIT = int(config.get("latency_wait", 60))

if min(num, set_num, TREES_PER_FILE, MEM_MB) < 1:
    raise ValueError("num, set_num, trees_per_file and mem_mb must be positive")

SIZE = "{}_{}".format(mint, maxt)
REPETITIONS = list(range(num))
SETS = ["set_{}".format(i) for i in range(set_num)]
sim_folder = os.path.join(folder, sf, SIZE)
OROV_folder = os.path.join(folder, "OROV_{}".format(sf), SIZE)
log_root = os.path.join(folder, "logs")
os.makedirs(log_root, exist_ok=True)


rule all:
    input:
        expand(os.path.join(OROV_folder, "{set}", "tree.{i}.nwk"),
               set=SETS, i=REPETITIONS),
        expand(os.path.join(OROV_folder, "{set}", "tree.{i}.log"),
               set=SETS, i=REPETITIONS)


rule tt2OROV:
    input:
        nwk=os.path.join(sim_folder, "{set}", "tree.{i}.nwk"),
        log=os.path.join(sim_folder, "{set}", "tree.{i}.log")
    output:
        nwk=os.path.join(OROV_folder, "{set}", "tree.{i}.nwk"),
        log=os.path.join(OROV_folder, "{set}", "tree.{i}.log")
    log:
        os.path.join(log_root, "transform_OROV", sf, SIZE,
                     "{set}", "tree.{i}.runner.log")
    params:
        # Inner params.mem values do not reserve additional Slurm memory.
        mem=MEM_MB,
        name="tt2ott_{}_{}_{{set}}_{{i}}".format(sf, SIZE),
        qos="normal",
        workflow=os.path.join(folder, "Snakefile_transform_OROV"),
        workdir=lambda wildcards, input: input.nwk + ".phylogenies",
        outdir=lambda wildcards, output: os.path.dirname(output.nwk),
        step_logs=os.path.join(log_root, "transform_OROV", sf, SIZE,
                               "{set}", "tree.{i}.steps"),
        cache=os.path.expanduser("~/.singularity")
    threads: 1
    resources:
        mem_mb=MEM_MB
    shell:
        r"""
        mkdir -p {params.workdir:q} {params.outdir:q} {params.step_logs:q}

        (
            cd {params.workdir:q}

            # Do not unlock automatically: a lock can belong to an active job.
            snakemake --snakefile {params.workflow:q} \
                --config in_nwk={input.nwk:q} out_nwk={output.nwk:q} \
                    folder={folder:q} trees_per_file={TREES_PER_FILE} \
                    log_dir={params.step_logs:q} \
                --keep-going --cores {threads} --rerun-incomplete \
                --latency-wait {LATENCY_WAIT} --printshellcmds \
                --use-singularity --singularity-prefix {params.cache:q} \
                --singularity-args "-B /pasteur"

            cp {input.log:q} {output.log:q}

            # As in the original workflow, clean intermediates only on success.
            # The runner and step logs are outside this directory and survive.
            cd {folder:q}
            rm -rf -- {params.workdir:q}
        ) > {log:q} 2>&1
        """
