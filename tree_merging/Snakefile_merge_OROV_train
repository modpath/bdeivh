localrules: all

folder = os.path.abspath(config.get("folder", '.'))

num_a = int(config.get("num", 100))
REPETITIONS = list(range(num_a))

num_b = int(config.get("num_b", 100))
SETS = list(range(num_b))

os.makedirs('logs', exist_ok=True)
tf = config.get("sf", 'orov_train')

mint = int(config.get("mint", 250))
maxt = int(config.get("maxt", 350))

train_folder = os.path.join(folder, tf, f'{mint}_{maxt}')250 to 350

TREES_PER_FILE = 10
to
snakemake_settings = "  --rerun-triggers mtime --keep-going --cores 1 --jobs 500 --rerun-incomplete --cluster  \"sbatch -c {threads} -o {folder}/logs/{params.name}.log -e {folder}/logs/{params.name}.log --mem={params.mem} -p common,dedicated --qos=fast  -J {params.name}\"  --use-singularity --singularity-prefix \"$HOME/.singularity\" --singularity-args \"-B /pasteur\" " \
    if "pasteur" in folder else " --rerun-triggers mtime --keep-going --cores 12 --use-singularity --singularity-prefix ~/.singularity --singularity-args \"--home ~\""

rule all:
    input:
        os.path.join(train_folder, '250_350_train_merged_all_OROV.nwk'),
        os.path.join(train_folder, '250_350_train_merged_all_OROV.log')

rule merge_all:
    input:
        nwks = expand(os.path.join(train_folder, 'set_{j}', 'tree.{k}.nwk'),
        j = SETS,
        k = REPETITIONS,
        ),

        logs = expand(os.path.join(train_folder, 'set_{j}', 'tree.{k}.log'),
        j = SETS,
        k = REPETITIONS,
        )

    output:
        nwks = os.path.join(train_folder, '250_350_train_merged_all_OROV.nwk'),
        logs = os.path.join(train_folder, '250_350_train_merged_all_OROV.log')

    params:
        name = "merge_all_OROV_train",
        mem=2000,
        qos='fast'

    threads: 1
    shell:
        """
        for f in {input.nwks}; do
            cat "$f"
            echo
        done > {output.nwks}

        first=1

        for f in {input.logs}; do
            if [ $first -eq 1 ]; then
                # print header + rest of the file
                cat "$f"
                first=0
            else
                # skip header (NR>1)
                tail -n +2 "$f"
            fi
        done > {output.logs}
        """