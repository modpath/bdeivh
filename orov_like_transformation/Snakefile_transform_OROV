import os

# Inner workflow: one job per stage, processing trees in their original order.
# The external training workflow supplies the Slurm CPU/memory allocation.
localrules: all

folder = os.path.abspath(config.get("folder", ".."))
in_nwk = os.path.abspath(config["in_nwk"])
out_nwk = os.path.abspath(config["out_nwk"])
TREES_PER_FILE = int(config.get("trees_per_file", 10))
if TREES_PER_FILE < 1:
    raise ValueError("trees_per_file must be positive")

WORKDIR = in_nwk + ".phylogenies"
log_dir = os.path.abspath(config.get("log_dir", os.path.join(WORKDIR, "logs")))
PHYLOGENIES = [os.path.join(WORKDIR, "phylogeny.{}.nwk".format(i))
               for i in range(TREES_PER_FILE)]
DATES = [os.path.join(WORKDIR, "dates.{}.tab".format(i))
         for i in range(TREES_PER_FILE)]
TIMETREES = [os.path.join(WORKDIR, "timetree.{}.nexus".format(i))
             for i in range(TREES_PER_FILE)]


rule all:
    input:
        out_nwk


rule tt2phylogeny:
    input:
        nwk=in_nwk
    output:
        # Declare every intermediate, not just tree 9.
        nwk=PHYLOGENIES,
        dates=DATES
    log:
        os.path.join(log_dir, "tt2phylogeny.log")
    params:
        mem=2000,
        name="tt2p",
        qos="fast",
        script=os.path.join(folder, "transmission2phylogeny.py"),
        nwk=os.path.join(WORKDIR, "phylogeny.*.nwk"),
        dates=os.path.join(WORKDIR, "dates.*.tab")
    threads: 1
    singularity: "docker://evolbioinfo/bdext:v0.1.80"
    shell:
        r"""
        mkdir -p {WORKDIR:q}
        python3 {params.script:q} --in_nwk {input.nwk:q} \
            --out_nwk {params.nwk:q} --out_dates {params.dates:q} \
            --mean_R 0.0012 --std_R 0.000075 --time_scale day \
            --min_date 10 --max_date 12 --s 11873 > {log:q} 2>&1
        """


rule date_lsd2:
    input:
        nwk=PHYLOGENIES,
        dates=DATES
    output:
        nexus=TIMETREES
    log:
        os.path.join(log_dir, "date_lsd2.log")
    params:
        mem=4000,
        name="lsd2",
        qos="fast"
    threads: 1
    singularity: "docker://evolbioinfo/lsd2:v2.4.1"
    shell:
        r"""
        (
            cd {WORKDIR:q}
            for ((i=0; i<{TREES_PER_FILE}; i++)); do
                echo "Processing tree.$i"
                lsd2 -i "phylogeny.$i.nwk" -d "dates.$i.tab" \
                    -s 11873 -o "wd.$i.wd" -R 24 -l 0
                test -s "wd.$i.wd.date.nexus"
                mv -- "wd.$i.wd.date.nexus" "timetree.$i.nexus"
                rm -f -- "wd.$i.wd"*
            done
        ) > {log:q} 2>&1
        """


rule nex2nwk:
    input:
        nexus=TIMETREES
    output:
        nwk=out_nwk
    log:
        os.path.join(log_dir, "nex2nwk.log")
    params:
        mem=2000,
        name="nex2nwk",
        qos="fast",
        script=os.path.join(folder, "nex2nwk.py")
    threads: 1
    singularity: "docker://evolbioinfo/bdext:v0.1.80"
    shell:
        r"""
        python3 {params.script:q} --in_nexus {input.nexus:q} \
            --out_nwk {output.nwk:q} > {log:q} 2>&1
        test -s {output.nwk:q}
        """
